# ── Data ──────────────────────────────────────────────────────────────────────
# Raw price data and per-timeframe feature CSVs — large, regenerated locally
data/btc_*.csv
data/backups/
data/manifest.json
# data/yearly_merged/ is NOT ignored — 10 CSVs (~90 MB) committed for Colab training
# data/yearly_1m/ is NOT ignored — 5 yearly 1m splits (~150 MB) committed for Colab labels

# ── Trained model weights (binary, too large for git) ────────────────────────
models/saved/*.keras
models/saved/*.pkl
models/saved/checkpoints_tft/
models/saved/checkpoints_bilstm/

# ── Training state (regenerated on each run) ──────────────────────────────────
models/saved/last_train_rows.txt
models/saved/training_cutoff.txt
models/saved/model_accuracies.json

# ── Keep these in git (small JSON config files) ───────────────────────────────
!models/saved/selected_features.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.Python

# ── Environment ───────────────────────────────────────────────────────────────
.env
*.env
venv/
.venv/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Sessions (paper trading history — local only) ────────────────────────────
papertrading/sessions/
